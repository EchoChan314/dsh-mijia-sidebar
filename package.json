{
  "name": "dsh-mijia-sidebar",
  "version": "1.0.1",
  "type": "module",
  "description": "One-click Mijia smart home control panel in the DSH sidebar: devices, properties and scenes straight from the mijiaAPI CLI — no model round-trip.",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "lib/*.py",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "EchoChan <czmecho@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoChan314/dsh-mijia-sidebar.git"
  },
  "homepage": "https://github.com/EchoChan314/dsh-mijia-sidebar#readme",
  "bugs": {
    "url": "https://github.com/EchoChan314/dsh-mijia-sidebar/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "mijia",
    "xiaomi",
    "mi-home",
    "smart-home",
    "sidebar",
    "home-automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/parse.js && python -m py_compile lib/state.py"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
